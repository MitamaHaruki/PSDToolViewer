<UserControl x:Class="PSDToolViewer.Views.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}"
             Stylus.IsFlicksEnabled="False" Stylus.IsTapFeedbackEnabled="False">
    <Grid x:Name="Host" ClipToBounds="True" Background="{DynamicResource App.CheckerBrush}">
        <Canvas x:Name="ImageCanvas">
            <Image x:Name="PreviewImage" Source="{Binding PreviewBitmap}" Stretch="Fill" SnapsToDevicePixels="True" />
        </Canvas>

        <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="{DynamicResource App.TextTertiary}" IsHitTestVisible="False" FontSize="14">
            <Run Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="40" /><LineBreak /><LineBreak />
            <Run Text="PSD・PNG・フォルダをドロップして開く" />
        </TextBlock>

        <!-- 拡大率 -->
        <Border x:Name="ZoomBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="4,2"
                CornerRadius="6" Background="{DynamicResource App.CardBackground}"
                BorderThickness="1" BorderBrush="{DynamicResource App.Divider}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SizeText" Text="{Binding DocumentSizeText}" VerticalAlignment="Center" Margin="6,0,8,0"
                           FontSize="12" Foreground="{DynamicResource App.TextSecondary}" />
                <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE71F;" ToolTip="縮小 (Ctrl+-)" Command="{Binding ZoomOutCommand}" />
                <TextBlock x:Name="ZoomText" Text="100%" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE8A3;" ToolTip="拡大 (Ctrl++)" Command="{Binding ZoomInCommand}" />
                <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE9A6;" ToolTip="ウィンドウに合わせる (Ctrl+0)" Command="{Binding ZoomFitCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
