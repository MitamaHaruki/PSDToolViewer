<Window x:Class="PSDToolViewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBackground}" Foreground="{DynamicResource App.Text}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="表示" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="レイヤー欄の位置" VerticalAlignment="Center" Margin="0,0,16,8" />
            <ComboBox x:Name="LayerPositionBox" Grid.Column="1" Margin="0,0,0,8">
                <ComboBoxItem Content="左（プレビューは右）" />
                <ComboBoxItem Content="右（プレビューは左）" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="テーマ" VerticalAlignment="Center" Margin="0,0,16,8" />
            <ComboBox x:Name="ThemeBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                <ComboBoxItem Content="システムの設定に合わせる" />
                <ComboBoxItem Content="ライト" />
                <ComboBoxItem Content="ダーク" />
            </ComboBox>
            <TextBlock Grid.Row="2" Text="プレビューの背景" VerticalAlignment="Center" Margin="0,0,16,8" />
            <ComboBox x:Name="BackgroundBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <ComboBoxItem Content="市松模様" />
                <ComboBoxItem Content="白" />
                <ComboBoxItem Content="黒" />
                <ComboBoxItem Content="グレー" />
            </ComboBox>
        </Grid>
        <CheckBox x:Name="ThumbnailBox" Content="レイヤー欄にサムネイルを表示する" Margin="0,4,0,0" />
        <CheckBox x:Name="SoftwareRenderingBox" Content="ソフトウェアで描画する" Margin="0,8,0,0" />
        <TextBlock Text="一部の端末では GPU で描画すると画像の赤と青が入れ替わるため、初期設定はオンです。動作が重いときはオフにすると速くなります（色や表示がおかしくならないか確認してください）。"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.TextSecondary}" Margin="28,2,0,0" />

        <TextBlock Text="更新" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,10" />
        <CheckBox x:Name="UpdateBox" Content="起動時に新しいバージョンを確認する" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="OK" MinWidth="88" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="キャンセル" MinWidth="88" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
