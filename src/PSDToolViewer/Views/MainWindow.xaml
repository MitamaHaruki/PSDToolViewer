<Window x:Class="PSDToolViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PSDToolViewer.Views"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="640" MinHeight="420"
        Icon="/Assets/AppIcon.ico"
        AllowDrop="True"
        UseLayoutRounding="True"
        Foreground="{DynamicResource App.Text}"
        Background="{DynamicResource App.WindowBackground}"
        FontFamily="Yu Gothic UI, Segoe UI"
        FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding CreateFolderCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding ToggleRadioCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ToggleForcedCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomFitCommand}" />
        <KeyBinding Gesture="Ctrl+D1" Command="{Binding ZoomActualCommand}" />
    </Window.InputBindings>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="AppIconImage" Source="/Assets/AppIcon.png" Width="16" Height="16" Margin="12,0,6,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="AppIcon_MouseLeftButtonDown" />

                <Menu x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" Background="Transparent"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <Menu.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource TitleMenuItemStyle}" />
                    </Menu.ItemContainerStyle>
                    <MenuItem Header="ファイル(_F)">
                        <MenuItem Header="新規(_N)" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                        <MenuItem Header="開く(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                        <MenuItem Header="フォルダを開く(_D)..." Command="{Binding OpenFolderCommand}" InputGestureText="Ctrl+Shift+O" />
                        <MenuItem x:Name="RecentMenu" Header="最近使ったファイル(_R)" SubmenuOpened="RecentMenu_SubmenuOpened">
                            <MenuItem Header="（なし）" IsEnabled="False" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="上書き保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                        <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                        <MenuItem Header="書き出し(_E)..." Command="{Binding ExportCommand}" InputGestureText="Ctrl+E" />
                        <Separator />
                        <MenuItem Header="終了(_X)" Click="Exit_Click" InputGestureText="Alt+F4" />
                    </MenuItem>
                    <MenuItem Header="編集(_E)">
                        <MenuItem Header="元に戻す(_U)" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                        <MenuItem Header="やり直し(_R)" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="クリップボードにコピー(_C)" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                        <Separator />
                        <MenuItem Header="フォルダを作成(_F)" Command="{Binding CreateFolderCommand}" InputGestureText="Ctrl+Shift+N" />
                        <MenuItem Header="ラジオボタン切替(_B)" Command="{Binding ToggleRadioCommand}" InputGestureText="Ctrl+R" />
                        <MenuItem Header="強制表示切替(_V)" Command="{Binding ToggleForcedCommand}" InputGestureText="Ctrl+F" />
                        <MenuItem Header="削除(_D)" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
                        <MenuItem Header="名前の変更(_M)" Command="{Binding RenameCommand}" InputGestureText="F2" />
                        <Separator />
                        <MenuItem Header="すべて選択(_A)" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
                    </MenuItem>
                    <MenuItem Header="表示(_V)">
                        <MenuItem Header="拡大(_I)" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                        <MenuItem Header="縮小(_O)" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                        <MenuItem Header="ウィンドウに合わせる(_F)" Command="{Binding ZoomFitCommand}" InputGestureText="Ctrl+0" />
                        <MenuItem Header="100%(_A)" Command="{Binding ZoomActualCommand}" InputGestureText="Ctrl+1" />
                        <Separator />
                        <MenuItem Header="すべて展開(_E)" Command="{Binding ExpandAllCommand}" />
                        <MenuItem Header="すべて折りたたむ(_C)" Command="{Binding CollapseAllCommand}" />
                    </MenuItem>
                    <MenuItem Header="ツール(_T)">
                        <MenuItem Header="設定(_S)..." Click="Settings_Click" />
                    </MenuItem>
                    <MenuItem Header="ヘルプ(_H)">
                        <MenuItem Header="更新を確認(_U)" Command="{Binding CheckUpdateCommand}" />
                        <Separator />
                        <MenuItem Header="バージョン情報(_A)..." Click="About_Click" />
                    </MenuItem>
                </Menu>

                <TextBlock x:Name="TitleText" Grid.Column="2" Text="{Binding Title}" Margin="12,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource App.TextSecondary}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" AutomationProperties.Name="最大化" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="閉じる" AutomationProperties.Name="閉じる" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ツールバー -->
            <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource App.Divider}">
                <StackPanel Orientation="Horizontal" Margin="8,2,8,6">
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE8E5;" Command="{Binding OpenCommand}" ToolTip="ファイル読込み (Ctrl+O)" AutomationProperties.Name="ファイル読込み" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE838;" Command="{Binding OpenFolderCommand}" ToolTip="フォルダ読込み (Ctrl+Shift+O)" AutomationProperties.Name="フォルダ読込み" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xEDE1;" Command="{Binding ExportCommand}" ToolTip="書き出し (Ctrl+E)" AutomationProperties.Name="書き出し" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE8C8;" Command="{Binding CopyCommand}" ToolTip="クリップボードにコピー (Ctrl+C)" AutomationProperties.Name="クリップボードにコピー" />
                    <CheckBox Content="透明余白をトリミング" IsChecked="{Binding TrimTransparent}" Margin="8,0,0,0" VerticalAlignment="Center"
                              Focusable="False" ToolTip="書き出しとプレビューからのドラッグで、透明な余白を切り詰めます" />
                    <Rectangle Style="{StaticResource ToolSeparatorStyle}" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE8F4;" Command="{Binding CreateFolderCommand}" ToolTip="フォルダを作成 (Ctrl+Shift+N)" AutomationProperties.Name="フォルダを作成" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xECCB;" Command="{Binding ToggleRadioCommand}" ToolTip="ラジオボタンにする／解除 (Ctrl+R)" AutomationProperties.Name="ラジオボタンにする／解除" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE718;" Command="{Binding ToggleForcedCommand}" ToolTip="強制表示にする／解除 (Ctrl+F)" AutomationProperties.Name="強制表示にする／解除" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE74D;" Command="{Binding DeleteCommand}" ToolTip="削除 (Delete)" AutomationProperties.Name="削除" />
                    <Button Style="{StaticResource ToolButtonStyle}" Content="&#xE8AC;" Command="{Binding RenameCommand}" ToolTip="名前の変更 (F2)" AutomationProperties.Name="名前の変更" />
                </StackPanel>
            </Border>

            <!-- 更新の通知 -->
            <Border Grid.Row="2" Background="{DynamicResource App.InfoBackground}" Padding="12,6"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource App.Divider}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButtonStyle}" Content="更新して再起動" Command="{Binding ApplyUpdateCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SubtleTextButtonStyle}" Content="後で" Command="{Binding DismissUpdateCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- レイヤー欄とプレビュー -->
            <Grid x:Name="ContentGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FirstColumn" Width="300" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SecondColumn" Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <views:LayerPanel x:Name="LayerPanel" Grid.Column="0" />
                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="False">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Rectangle Width="1" Fill="{DynamicResource App.Divider}" HorizontalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <views:PreviewPanel x:Name="PreviewPanel" Grid.Column="2" />
            </Grid>

            <!-- 処理中の表示 -->
            <Grid Grid.Row="1" Grid.RowSpan="3" Background="Transparent"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Grid x:Name="BusyContent" Background="{DynamicResource App.OverlayBackground}" Opacity="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- すぐ終わる処理でちらつかないよう少し待ってから表示する -->
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                                 BeginTime="0:0:0.2" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border Background="{DynamicResource App.CardBackground}" CornerRadius="8" Padding="24,18" MinWidth="320"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource App.Divider}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding BusyMessage}" FontSize="14" Margin="0,0,0,12" />
                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding BusyProgress, Mode=OneWay}" />
                            <Button Style="{StaticResource SubtleTextButtonStyle}" Content="キャンセル" Command="{Binding CancelBusyCommand}"
                                    HorizontalAlignment="Right" Margin="0,12,0,0"
                                    Visibility="{Binding BusyCancelable, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
